# Copy to .env (never commit .env). All values are optional.
# Folder containing master_feature_matrix.csv
DT_DATA_DIR=./data
# Folder containing the model_*.joblib files, model_scaler.joblib and model_metadata.json
DT_MODEL_DIR=./models
# Default model preselected in the UI (see core/config.py MODEL_REGISTRY keys)
DT_DEFAULT_MODEL=elasticnet
# Forecast horizon limits (months)
DT_DEFAULT_HORIZON=42
DT_MAX_HORIZON=42
# How many runs the "Compare runs" tab keeps in memory
DT_MAX_SAVED_RUNS=10
